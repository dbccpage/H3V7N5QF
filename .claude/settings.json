{
  "model": "fable",
  "effortLevel": "xhigh",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(uv *)",
      "Bash(lake update *)",
      "Bash(lake exe cache *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Start-BitsTransfer *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": []
    },
    "filesystem": {
      "denyRead": [
        "~/source/repos",
        "~/.claude/projects",
        "~/.remember",
        "~/AppData/Local/Temp/claude"
      ],
      "allowRead": [
        "~/source/repos/H3V7N5QF"
      ]
    }
  },
  "disableClaudeAiConnectors": true,
  "enableAllProjectMcpServers": false,
  "disableAllHooks": true,
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "disableBundledSkills": true,
  "enableArtifact": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "enabledPlugins": {
    "aikido@claude-plugins-official": false,
    "build-with-wordpress@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "math-olympiad@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "preset-cli-skills@claude-plugins-official": false,
    "prisma@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
}
