{
  "model": "fable",
  "effortLevel": "xhigh",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Agent"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git clone *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(uv *)",
      "Bash(lake update *)",
      "Bash(lake exe cache *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Start-BitsTransfer *)",
      "Edit(.claude/**)",
      "PowerShell(git clone *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git push *)",
      "PowerShell(git remote *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(uv *)",
      "PowerShell(lake update *)",
      "PowerShell(lake exe cache *)",
      "Bash(curl.exe *)",
      "PowerShell(curl.exe *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "mcp__*",
      "SendMessage",
      "ListAgents"
    ]
  },
  "crossSessionInbound": "refuse",
  "disableClaudeAiConnectors": true,
  "enableAllProjectMcpServers": false,
  "disableAllHooks": true,
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "disableBundledSkills": true,
  "enableArtifact": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "enabledPlugins": {
    "aikido@claude-plugins-official": false,
    "build-with-wordpress@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "math-olympiad@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "preset-cli-skills@claude-plugins-official": false,
    "prisma@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
