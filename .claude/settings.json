    "mattpocock-skills@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "modern-web-guidance@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "preset-cli-skills@claude-plugins-official": false,
    "prisma@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  }
