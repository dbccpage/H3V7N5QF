{
  "model": "fable",
  "effortLevel": "xhigh",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": false,
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Agent",
      "Task",
      "TodoWrite",
      "Skill",
      "SlashCommand",
      "ExitPlanMode",
      "EnterPlanMode",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "SendMessage",
      "ListAgents"
    ],
    "deny": []
